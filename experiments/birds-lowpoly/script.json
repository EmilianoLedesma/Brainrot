 "captions": [
  {
   "id": "c0",
   "at": 3,
   "until": 31,
   "style": "phrase",
   "text": "Por qué las aves no"
  },
  {
   "id": "c1",
   "at": 32,
   "until": 102,
   "style": "phrase",
   "text": "se electrocutan en cables"
  },
  {
   "id": "c2",
   "at": 107,
   "until": 148,
   "style": "phrase",
   "text": "Un cable puede llevar treinta"
  },
  {
   "id": "c3",
   "at": 149,
   "until": 189,
   "style": "phrase",
   "text": "y cinco mil voltios"
  },
  {
   "id": "c4",
   "at": 190,
   "until": 220,
   "style": "phrase",
   "text": "y el pájaro encima"
  },
  {
   "id": "c5",
   "at": 221,
   "until": 273,
   "style": "phrase",
   "text": "ni se despeina"
  },
  {
   "id": "c6",
   "at": 275,
   "until": 301,
   "style": "phrase",
   "text": "Cómo"
  },
  {
   "id": "c7",
   "at": 302,
   "until": 340,
   "style": "phrase",
   "text": "Primero una idea"
  },
  {
   "id": "c8",
   "at": 341,
   "until": 394,
   "style": "phrase",
   "text": "que cambia todo"
  },
  {
   "id": "c9",
   "at": 395,
   "until": 428,
   "style": "phrase",
   "text": "Lo que hace daño no"
  },
  {
   "id": "c10",
   "at": 429,
   "until": 488,
   "style": "phrase",
   "text": "es el voltaje solo"
  },
  {
   "id": "c11",
   "at": 490,
   "until": 561,
   "style": "phrase",
   "text": "Es la diferencia de voltaje"
  },
  {
   "id": "c12",
   "at": 563,
   "until": 600,
   "style": "phrase",
   "text": "Esa diferencia es lo que"
  },
  {
   "id": "c13",
   "at": 601,
   "until": 632,
   "style": "phrase",
   "text": "empuja la corriente a"
  },
  {
   "id": "c14",
   "at": 633,
   "until": 679,
   "style": "phrase",
   "text": "través de un cuerpo"
  },
  {
   "id": "c15",
   "at": 680,
   "until": 742,
   "style": "phrase",
   "text": "Ahora mira al pájaro"
  },
  {
   "id": "c16",
   "at": 744,
   "until": 773,
   "style": "phrase",
   "text": "Tiene los dos pies"
  },
  {
   "id": "c17",
   "at": 774,
   "until": 828,
   "style": "phrase",
   "text": "en el mismo cable"
  },
