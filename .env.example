# Supabase project settings -> API. The service_role key bypasses RLS: keep it
# server-side only, never in a browser or a public repo.
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=

# New files stay local; database paths remain portable. Use export-media/import-media
# when switching computers; see docs/moving-between-computers.md.
BRAINROT_MEDIA_STORAGE=local
BRAINROT_MEDIA_ROOT=media
# Legacy cloud downloads are cached locally. Set supabase to opt into cloud writes.
MEDIA_BUCKET=media
# Optional publicly reachable API base URL, needed for Instagram to fetch local media.
BRAINROT_PUBLIC_API_URL=

# Optional free Pexels key; NASA search does not need one.
PEXELS_API_KEY=

# Google OAuth Web application. Enable YouTube Data API v3 + YouTube Analytics API.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8001/youtube/callback

# Story generation, Reddit rewriting and clip selection. Default: local Claude
# Code subscription login; use codex for your saved ChatGPT/Codex login.
# No automatic provider fallback. anthropic explicitly opts into API billing.
BRAINROT_LLM_PROVIDER=claude-code
BRAINROT_LLM_TIMEOUT_SECONDS=180
# Optional model overrides; empty uses each CLI's default model.
BRAINROT_CLAUDE_MODEL=
BRAINROT_CODEX_MODEL=
# Optional executable paths, useful when CLIs are not on the worker's PATH.
BRAINROT_CLAUDE_BIN=
BRAINROT_CODEX_BIN=
# Used only when BRAINROT_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Direct Postgres connection, used only to apply migrations with psql.
# Project Settings -> Database -> Connection string -> Session pooler.
#
# Use the pooler host, not `db.PROJECT-REF.supabase.co`: the direct host only
# publishes an AAAA record and is unreachable from an IPv4-only network.
# Three things differ from the string the dashboard shows by default:
#   - user is `postgres.PROJECT-REF`, not `postgres`
#   - host is `aws-0-REGION.pooler.supabase.com` (REGION is the project's region)
#   - special characters in the password must be percent-encoded (! -> %21)
DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Shared secret for the dashboard API, sent by the web app as the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# With this unset the API rejects every request.
DASHBOARD_API_KEY=

# Comma-separated origins allowed to call the API. Vite's dev server is the default.
DASHBOARD_ORIGINS=http://localhost:5173

# Reddit app credentials for H2b (https://www.reddit.com/prefs/apps, type "script").
# Only public reads are needed, so no username or password.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brainrot/0.1

# Whisper size used only when a YouTube video has no captions of its own.
# Downloaded models are cached in this project's media/models/whisper folder.
WHISPER_MODEL=base
